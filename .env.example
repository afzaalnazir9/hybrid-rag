# Copy this file to .env. Never commit .env.

# Optional: with a key, answers come from Claude. Without one, a local
# Ollama model is used instead (install Ollama, then: ollama pull llama3.2:3b).
ANTHROPIC_API_KEY=

# LLM_PROVIDER=auto        # auto | claude | ollama
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://localhost:11434

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low is faster and cheaper; high is more thorough
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=5
